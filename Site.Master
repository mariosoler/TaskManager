<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.Master.vb" Inherits="TaskManager.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TaskManager</title>
    <link id="lnkIcono" runat="server" rel="icon" type="image/svg+xml" />
    <link id="lnkEstilos" runat="server" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">
        <header class="barra">
            <a id="lnkInicio" runat="server" href="~/Tableros.aspx" class="logo"><img id="imgLogo" runat="server" alt="" class="logo-icono" /><span class="logo-texto">Task<span>Manager</span></span></a>
            <asp:PlaceHolder ID="phNavegacion" runat="server" Visible="false">
                <nav class="barra-nav">
                    <a runat="server" href="~/Tableros.aspx">Tableros</a>
                    <a runat="server" href="~/Buscar.aspx">Buscar</a>
                </nav>
            </asp:PlaceHolder>
            <asp:PlaceHolder ID="phUsuario" runat="server" Visible="false">
                <div class="barra-usuario">
                    <a runat="server" href="~/Perfil.aspx" class="barra-perfil" title="Mi perfil">
                        <span class="avatar"><asp:Literal ID="litIniciales" runat="server" Mode="Encode" /></span>
                        <span class="barra-nombre"><asp:Literal ID="litNombreUsuario" runat="server" Mode="Encode" /></span>
                    </a>
                    <asp:LinkButton ID="lnkSalir" runat="server" CssClass="boton boton-claro" CausesValidation="false">Cerrar sesión</asp:LinkButton>
                </div>
            </asp:PlaceHolder>
        </header>
        <main class="contenido">
            <asp:ContentPlaceHolder ID="Contenido" runat="server" />
        </main>
    </form>
    <asp:ContentPlaceHolder ID="Scripts" runat="server" />
</body>
</html>
