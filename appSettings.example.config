<?xml version="1.0" encoding="utf-8"?>
<!--
  Ajustes de cada instalación (opcional). Web.config los lee con <appSettings file="appSettings.config">:
  lo que se ponga aquí sustituye al valor por defecto de Web.config; si el archivo no existe, se usan esos valores.

  - En desarrollo: copiar este archivo como appSettings.config (excluido de git) solo si se quiere cambiar algo.
  - Al publicar a una carpeta, Visual Studio crea appSettings.config en el destino a partir de esta plantilla
    si todavía no existe (nunca sobrescribe el del servidor).
-->
<appSettings>
  <!--
    Carpeta de las imágenes de fondo que suben los usuarios a los tableros.
    - Ruta absoluta (recomendada en un servidor, fuera de la carpeta del sitio para no perderlas al publicar):
        D:\Datos\TaskManager\Fondos
    - O ruta virtual dentro del sitio: ~/App_Data/Fondos (valor por defecto)
    La identidad del grupo de aplicaciones de IIS necesita permiso de modificación sobre esa carpeta.
    IIS no debe servirla directamente: las imágenes se entregan con Fondo.ashx, que comprueba el acceso.
  -->
  <add key="RutaFondosTableros" value="~/App_Data/Fondos" />
</appSettings>
