<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformación que se aplica al PUBLICAR (configuración Release). Más información: https://go.microsoft.com/fwlink/?LinkId=125889

  El Web.config publicado lleva dentro la conexión a la base de datos y las carpetas de fondos y adjuntos con marcadores
  [ENTRE_CORCHETES] para sustituir en el servidor. Aquí solo hay marcadores: nunca datos ni contraseñas reales.
  Ojo: cada publicación genera de nuevo el Web.config con los marcadores; al actualizar un servidor ya configurado,
  conserva su Web.config o vuelve a poner los valores.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings xdt:Transform="Replace">
    <!--
      CONEXIÓN A LA BASE DE DATOS: sustituye [SERVIDOR_SQL] por el servidor de SQL Server (p. ej. SQL01 o SQL01\INSTANCIA).
      - Autenticación de Windows (recomendada): IIS se conecta con la identidad del grupo de aplicaciones
        (p. ej. IIS APPPOOL\TaskManager), que necesita un inicio de sesión en SQL Server con acceso a la base TaskManager.
      - Con usuario de SQL Server, cambia "Integrated Security=True" por "User Id=[USUARIO];Password=[CONTRASEÑA]".
    -->
    <add name="TaskManager"
         connectionString="Server=[SERVIDOR_SQL];Database=TaskManager;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!--
      CARPETA DE LOS FONDOS DE TABLERO: sustituye [RUTA_CARPETA_FONDOS] por una ruta absoluta, mejor fuera de la carpeta
      del sitio para no perder las imágenes al publicar (p. ej. D:\Datos\TaskManager\Fondos), o usa ~/App_Data/Fondos.
      La identidad del grupo de aplicaciones de IIS necesita permiso de modificación sobre esa carpeta.
    -->
    <add key="RutaFondosTableros" value="[RUTA_CARPETA_FONDOS]"
         xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
    <!--
      CARPETA DE LOS ADJUNTOS DE LAS TARJETAS: sustituye [RUTA_CARPETA_ADJUNTOS] por una ruta absoluta, mejor fuera de la
      carpeta del sitio (p. ej. D:\Datos\TaskManager\Adjuntos), o usa ~/App_Data/Adjuntos.
      La identidad del grupo de aplicaciones de IIS necesita permiso de modificación sobre esa carpeta.
    -->
    <add key="RutaAdjuntosTarjetas" value="[RUTA_CARPETA_ADJUNTOS]"
         xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
