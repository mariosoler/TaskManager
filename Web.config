<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <!-- La cadena real está en connectionStrings.config (local, excluido de git). Ver connectionStrings.example.config -->
  <connectionStrings configSource="connectionStrings.config" />
  <appSettings>
    <!-- Validadores de Web Forms sin jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Carpeta de las imágenes de fondo de los tableros: ruta absoluta (p. ej. D:\Datos\TaskManager\Fondos)
         o virtual (~/...). Usar una carpeta que IIS no sirva directamente: las imágenes se entregan con Fondo.ashx. -->
    <add key="RutaFondosTableros" value="~/App_Data/Fondos" />
  </appSettings>
  <system.web>
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.8.1" />
    <!-- maxRequestLength (KB): admite fondos de tablero de hasta 5 MB -->
    <httpRuntime targetFramework="4.8.1" enableVersionHeader="false" maxRequestLength="6144" />
    <globalization culture="es-ES" uiCulture="es-ES" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <!-- Sesión con cookie de Forms Authentication; solo HTTPS -->
    <authentication mode="Forms">
      <forms name=".TaskManagerAuth" loginUrl="~/Login.aspx" defaultUrl="~/Tableros.aspx" timeout="120"
             slidingExpiration="true" requireSSL="true" cookieless="UseCookies" />
    </authentication>
    <!-- Todo requiere sesión salvo las rutas permitidas abajo -->
    <authorization>
      <deny users="?" />
    </authorization>
    <httpCookies httpOnlyCookies="true" requireSSL="true" />
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Registro.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <staticContent>
      <!-- Fuente del logo (Content/fuentes); algunas versiones de IIS no conocen .woff2 -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>