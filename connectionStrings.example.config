<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla. Copiar como connectionStrings.config (excluido de git) y rellenar con los datos locales.
  Opción recomendada: autenticación de Windows
    Server=<SERVIDOR>;Database=TaskManager;Integrated Security=True;TrustServerCertificate=True
-->
<connectionStrings>
  <add name="TaskManager"
       connectionString="Server=<SERVIDOR>;Database=TaskManager;User Id=<USUARIO>;Password=<PASSWORD>;TrustServerCertificate=True"
       providerName="System.Data.SqlClient" />
</connectionStrings>
