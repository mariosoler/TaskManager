<?xml version="1.0" encoding="utf-8"?>
<!--
  Cadena de conexión a la base de datos TaskManager.

  - En desarrollo: copiar este archivo como connectionStrings.config (excluido de git) y rellenarlo.
  - Al publicar a una carpeta, Visual Studio crea connectionStrings.config en el destino a partir de esta
    plantilla si todavía no existe (nunca sobrescribe el del servidor). Edítalo allí con los datos reales.

  Opción recomendada: autenticación de Windows. En IIS se conecta con la identidad del grupo de aplicaciones
  (p. ej. "IIS APPPOOL\TaskManager"), que necesita un inicio de sesión en SQL Server con acceso a la base:
    Server=<SERVIDOR>;Database=TaskManager;Integrated Security=True;TrustServerCertificate=True

  Alternativa con usuario de SQL Server (no guardar nunca esta contraseña en el repositorio):
    Server=<SERVIDOR>;Database=TaskManager;User Id=<USUARIO>;Password=<PASSWORD>;TrustServerCertificate=True
-->
<connectionStrings>
  <add name="TaskManager"
       connectionString="Server=&lt;SERVIDOR&gt;;Database=TaskManager;Integrated Security=True;TrustServerCertificate=True"
       providerName="System.Data.SqlClient" />
</connectionStrings>
